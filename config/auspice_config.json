{
  "title": "Nextstrain build for Yam Mosaic Virus",
  "maintainers": [
    {
      "name": "Rosana Blawid, Carlos Henrique Machado Dias and Dayla Geovana Pereira Bezerra"
    }
  ],
  "build_url": "https://github.com/rblawid/Nextstrain-YMV-Brazil",
  "colorings": [
    {
      "key": "num_date",
      "title": "Date",
      "type": "continuous"
    },
    {
      "key": "region",
      "title": "Region",
      "type": "categorical"
    },
    {
      "key": "country",
      "title": "Country",
      "type": "categorical"
    },
    {
      "key": "host",
      "title": "Host",
      "type": "categorical"
    }
  ],
  "geo_resolutions": [
    "country"
  ],
  "panels": [
    "tree",
    "map",
    "entropy"
  ],
  "display_defaults": {
    "color_by": "country",
    "geo_resolution": "country",
    "distance_measure": "div",
    "layout": "rect",
    "map_triplicate": true
  },
  "filters": [
    "region",
    "country",
    "host",
    "date"
  ]
